{
  "name": "wayfarer-world-kit",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Wayfarer authoritative persistent multiplayer realm with server-backed PolyCodex resonance and Moonlight Cavern",
  "exports": {
    "./wildlife": "./dist/wildlife.js",
    ".": "./dist/world.js",
    "./protocol": "./dist/protocol.js",
    "./catalog": "./dist/catalog.js",
    "./geometry": "./dist/geometry.js",
    "./navigation": "./dist/navigation.js",
    "./movement": "./dist/movement.js",
    "./navigation-chunks": "./dist/navigation-chunks.js",
    "./construction": "./dist/construction.js",
    "./crossings": "./dist/crossings.js",
    "./site-placement": "./dist/site-placement.js",
    "./scene-meshes": "./dist/scene-meshes.js",
    "./session": "./dist/session.js",
    "./adapters/coordinates": "./dist/adapters/coordinates.js",
    "./adapters/iso": "./dist/adapters/iso.js",
    "./adapters/preferences": "./dist/adapters/preferences.js",
    "./fixed-clock": "./dist/fixed-clock.js",
    "./realm-runtime": "./dist/realm-runtime.js",
    "./replication": "./dist/replication.js",
    "./transport-guard": "./dist/transport-guard.js",
    "./realm-contract": "./dist/realm-contract.js",
    "./snapshot-buffer": "./dist/snapshot-buffer.js",
    "./world-atlas": "./dist/world-atlas.js",
    "./terrain-survey": "./dist/terrain-survey.js",
    "./character-motion": "./dist/character-motion.js",
    "./babylon-mesh": "./dist/babylon-mesh.js",
    "./soft-patch": "./dist/soft-patch.js",
    "./asset-fetch": "./dist/asset-fetch.js",
    "./multitool": "./dist/multitool.js",
    "./soft-tools": "./dist/soft-tools.js",
    "./abc-wind": "./dist/abc-wind.js",
    "./persistence": "./dist/persistence.js",
    "./progression": "./dist/progression.js",
    "./weapon-builds": "./dist/weapon-builds.js",
    "./hero-appearance": "./dist/hero-appearance.js",
    "./skill-directory": "./dist/skill-directory.js",
    "./realm-weather": "./dist/realm-weather.js",
    "./art-directory": "./dist/art-directory.js",
    "./render-recovery": "./dist/render-recovery.js",
    "./xam-agent": "./dist/xam-agent.js",
    "./xam-view": "./dist/xam-view.js",
    "./resonance-codex": "./dist/resonance-codex.js",
    "./resonance-authority": "./dist/resonance-authority.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run mesh:bundle && npm run realm:bundle && npm run visual:bundle && npm run characters:bundle",
    "visual:bundle": "esbuild src/pglite-plugin.ts --bundle --platform=browser --format=esm --minify --legal-comments=linked --outfile=preview/pglite-plugin.bundle.js && esbuild src/pglite-worker.ts --bundle --platform=browser --format=esm --minify --legal-comments=linked --external:node:* --outfile=preview/pglite-worker.bundle.js && node tools/copy-pglite-assets.mjs",
    "test": "npm run build && node --test --test-concurrency=2 test/*.test.mjs",
    "demo": "node dist/example.js",
    "demo:walk": "node dist/navigation-example.js",
    "demo:crossing": "node dist/crossing-example.js",
    "atlas:export": "node tools/export-atlas.mjs",
    "preview": "node tools/preview.mjs",
    "demo:realm": "node dist/realm-example.js",
    "realm": "node tools/realm-server.mjs",
    "contract:export": "node tools/export-contract.mjs",
    "atlas:catalog": "node tools/export-world-atlas.mjs",
    "mesh:bundle": "esbuild src/mesh-lab.ts --bundle --format=esm --minify --legal-comments=linked --outfile=preview/mesh-lab.bundle.js",
    "realm:bundle": "esbuild src/realm-3d.ts --bundle --format=esm --minify --legal-comments=linked --outfile=preview/realm-3d.bundle.js",
    "assets:catalog": "node tools/export-character-assets.mjs",
    "assets:validate:py": "python3 python/validate_assets.py",
    "start": "node tools/server.mjs",
    "dev": "node tools/visual-preview.mjs",
    "replay": "node tools/replay.mjs",
    "test:persistence": "node --test test/profile-persistence.test.mjs",
    "characters:bundle": "esbuild src/character-studio.ts --bundle --platform=browser --format=esm --minify --legal-comments=linked --outfile=preview/character-studio.bundle.js",
    "start:local": "node tools/realm-server.mjs",
    "test:release": "node --test test/release-*.test.mjs",
    "backup": "node tools/backup.mjs",
    "test:polycodex": "node --test test/resonance-codex.test.mjs test/resonance-authority.test.mjs test/hud-controls.test.mjs test/polycodex-surface.test.mjs test/celestial-expansion-source.test.mjs"
  },
  "devDependencies": {
    "@types/emscripten": "1.41.6",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@babylonjs/core": "9.28.0",
    "@electric-sql/pglite": "0.5.4",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
